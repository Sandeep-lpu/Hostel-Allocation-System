# ==============================================================================
# HOSTEL ALLOCATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
APP_NAME="Hostel Allocation Engine"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB 7 Replica Set)
# Multi-document ACID transactions require replica set rs0.
# directConnection=true bypasses server discovery issues during local dev.
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/hostel_allocation?replicaSet=rs0&directConnection=true
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=100
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# ------------------------------------------------------------------------------
# 3. FIELD-LEVEL ENCRYPTION (AES-256-CBC at Rest)
# DB_ENCRYPTION_SECRET: Exactly 32 characters (256-bit key)
# DB_ENCRYPTION_SALT: Exactly 16 characters (128-bit salt)
# WARNING: Changing these in production will corrupt existing encrypted records!
# ------------------------------------------------------------------------------
DB_ENCRYPTION_SECRET=b4f89d34e6214a1a9e8712bc90fa72d1
DB_ENCRYPTION_SALT=8c7e9a01f4b23d5e

# ------------------------------------------------------------------------------
# 4. REDIS & BULLMQ ASYNC PROCESSING
# High-concurrency queue engine backed by Redis 7
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
ALLOCATION_QUEUE_NAME=allocation-job-queue
DOCUMENT_QUEUE_NAME=document-generation-queue
QUEUE_CONCURRENCY=50

# ------------------------------------------------------------------------------
# 5. WEBHOOK & EXTERNAL INTEGRATIONS
# Secret key used to sign and verify HMAC SHA-256 payloads
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=whsec_a7f920be534948a3915bc3210459daee

# ------------------------------------------------------------------------------
# 6. DOCUMENT ENGINE & STORAGE (Puppeteer & PDF Generation)
# Headless Chromium flags optimized for Linux/Docker & local environments
# ------------------------------------------------------------------------------
PUPPETEER_HEADLESS=new
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_ARGS="--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu"
LOCAL_STORAGE_PATH=./storage/documents
TEMPLATES_PATH=./src/templates
